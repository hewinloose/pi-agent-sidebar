{
  "name": "pi-sidebar",
  "displayName": "Pi Agent Sidebar",
  "description": "A focused pi coding-agent workspace in the VS Code auxiliary sidebar.",
  "version": "1.0.3",
  "publisher": "dairycode",
  "license": "MIT",
  "author": "Liu Ze",
  "repository": {
    "type": "git",
    "url": "https://github.com/dairycode/pi-agent-sidebar.git"
  },
  "homepage": "https://github.com/dairycode/pi-agent-sidebar#readme",
  "bugs": {
    "url": "https://github.com/dairycode/pi-agent-sidebar/issues"
  },
  "engines": {
    "vscode": "^1.129.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "pi",
    "coding agent",
    "ai",
    "assistant"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "icon": "assets/pi-logo.png",
  "files": [
    "assets/**",
    "dist/**",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "piAgentSidebar.open",
        "title": "Pi Agent: 打开",
        "icon": "assets/pi.svg"
      },
      {
        "command": "piAgentSidebar.focusInput",
        "title": "Pi Agent: 聚焦输入框（含所选内容）"
      },
      {
        "command": "piAgentSidebar.newSession",
        "title": "Pi Agent: 新建会话",
        "icon": "$(add)"
      },
      {
        "command": "piAgentSidebar.newTrellisTask",
        "title": "Pi Agent: 新建 Trellis 任务",
        "icon": "$(checklist)"
      },
      {
        "command": "piAgentSidebar.restart",
        "title": "Pi Agent: 重启运行时",
        "icon": "$(refresh)"
      },
      {
        "command": "piAgentSidebar.showLogs",
        "title": "Pi Agent: 查看日志",
        "icon": "$(output)"
      },
      {
        "command": "piAgentSidebar.renameSession",
        "title": "Pi Agent: 重命名会话",
        "icon": "$(edit)"
      },
      {
        "command": "piAgentSidebar.exportHtml",
        "title": "Pi Agent: 导出会话为 HTML",
        "icon": "$(export)"
      },
      {
        "command": "piAgentSidebar.explainSelection",
        "title": "Pi Agent: 解释所选内容"
      },
      {
        "command": "piAgentSidebar.explainFile",
        "title": "Pi Agent: 解释此文件"
      },
      {
        "command": "piAgentSidebar.refactorSelection",
        "title": "Pi Agent: 重构所选内容"
      },
      {
        "command": "piAgentSidebar.generateTests",
        "title": "Pi Agent: 为所选内容生成测试"
      },
      {
        "command": "piAgentSidebar.explainDiagnostics",
        "title": "Pi Agent: 解释所选内容中的问题"
      },
      {
        "command": "piAgentSidebar.addFilesToInput",
        "title": "Pi Agent: 将文件或文件夹添加到输入"
      }
    ],
    "submenus": [
      {
        "id": "piAgentSidebar.editorContext",
        "label": "Pi Agent",
        "icon": "assets/pi.svg"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "piAgentSidebar.editorContext",
          "group": "navigation@100"
        }
      ],
      "explorer/context": [
        {
          "command": "piAgentSidebar.addFilesToInput",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "navigation@100"
        }
      ],
      "editor/title": [
        {
          "command": "piAgentSidebar.open",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "piAgentSidebar.addFilesToInput",
          "when": "false"
        }
      ],
      "piAgentSidebar.editorContext": [
        {
          "command": "piAgentSidebar.focusInput",
          "when": "editorHasSelection",
          "group": "1_ask@0"
        },
        {
          "command": "piAgentSidebar.explainSelection",
          "when": "editorHasSelection",
          "group": "1_ask@1"
        },
        {
          "command": "piAgentSidebar.refactorSelection",
          "when": "editorHasSelection",
          "group": "1_ask@2"
        },
        {
          "command": "piAgentSidebar.generateTests",
          "when": "editorHasSelection",
          "group": "1_ask@3"
        },
        {
          "command": "piAgentSidebar.explainDiagnostics",
          "when": "editorHasSelection",
          "group": "1_ask@4"
        },
        {
          "command": "piAgentSidebar.explainFile",
          "group": "2_file@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "piAgentSidebar.focusInput",
        "key": "ctrl+escape",
        "mac": "cmd+escape",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Pi Agent",
      "properties": {
        "piAgentSidebar.binaryPath": {
          "type": "string",
          "default": "pi",
          "scope": "machine",
          "description": "Path to the pi executable. Use an absolute path when VS Code cannot resolve pi from PATH."
        },
        "piAgentSidebar.additionalArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "Additional arguments passed to pi before RPC mode is enabled. Session and run-mode arguments are managed by this extension."
        },
        "piAgentSidebar.sessionDirectory": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional session storage directory passed to pi with --session-dir. Leave empty to use pi's default."
        },
        "piAgentSidebar.trustProjectResources": {
          "type": "boolean",
          "default": true,
          "description": "Load project-local pi settings, extensions, skills, and prompts when the VS Code workspace is trusted."
        },
        "piAgentSidebar.restoreSession": {
          "type": "boolean",
          "default": true,
          "description": "Restore the last Pi Agent session used in this workspace after VS Code reloads."
        },
        "piAgentSidebar.autoRetry": {
          "type": "boolean",
          "default": true,
          "description": "Automatically retry transient provider errors (overloaded, rate limit, 5xx, and interrupted streams)."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "pi-agent-sidebar-secondary",
          "title": "Pi Agent",
          "icon": "assets/pi.svg"
        }
      ]
    },
    "views": {
      "pi-agent-sidebar-secondary": [
        {
          "type": "webview",
          "id": "piAgentSidebar.chatView",
          "name": "Pi Agent"
        }
      ]
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Pi can read, edit, and execute files. Trust the workspace before starting the agent."
    }
  },
  "scripts": {
    "clean": "node scripts/build.mjs --clean",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test test/unit/host/*.test.mjs test/unit/shared/*.test.mjs test/unit/webview/*.test.mjs test/integration/*.test.mjs",
    "preview": "npm run build && node scripts/preview.mjs",
    "test:rpc": "node scripts/rpc-smoke.mjs",
    "test": "npm run typecheck && npm run test:unit",
    "check:generated": "node scripts/check-generated.mjs",
    "verify": "npm run typecheck && npm run test:unit && npm run check:generated",
    "package": "npm run typecheck && npm run test:unit && node scripts/build.mjs --production && vsce package --no-dependencies",
    "vscode:prepublish": "node scripts/build.mjs --production"
  },
  "knip": {
    "entry": [
      "src/extension.ts",
      "webview/main.ts",
      "scripts/*.mjs",
      "scripts/**/*.mjs",
      "test/**/*.mjs"
    ],
    "project": [
      "src/**/*.ts",
      "webview/**/*.ts",
      "shared/**/*.ts",
      "scripts/**/*.mjs",
      "test/**/*.mjs"
    ],
    "ignoreDependencies": [
      "@vscode/codicons"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.125.0",
    "@vscode/codicons": "^0.0.44",
    "@vscode/vsce": "^3.6.0",
    "dompurify": "3.4.14",
    "esbuild": "^0.25.5",
    "highlight.js": "11.12.0",
    "marked": "^15.0.12",
    "marked-cjk-friendly": "0.1.3",
    "mermaid": "^11.17.2",
    "typescript": "^5.8.3"
  }
}
